# .env.example — variable NAMES only, never real values.
# The ONE env file ever committed. Copy it to deployment/local/.env and fill
# in real values there; that copy is never committed.

# --- server (WS + MCP, 1 process, D13) ---
# WS port (default 8765). Flag --port wins.
PORT=8765
# Bind address (default localhost). Flag --host wins.
HOST=localhost
# Token extension phải gửi khi connect. BẮT BUỘC khi HOST ngoài localhost.
EXT_TOKEN=

# --- Playwright bridge (D21) ---
# Chrome DevTools endpoint for browser_eval. Set only when Chrome runs with
# --remote-debugging-port=9222; browser_eval errors with CDP_NOT_AVAILABLE
# otherwise.
CDP_URL=
