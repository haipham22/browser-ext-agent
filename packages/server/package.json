{
  "name": "@haipham22/browser-ext-agent",
  "version": "0.1.0",
  "description": "Browser agent MCP: agent -> MCP (stdio) -> WS server -> Chrome extension -> page. Run with npx.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "browser-ext-agent": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:ws --external:@modelcontextprotocol/sdk --external:zod --external:playwright-core && node make-bin.mjs && tsc --noEmit",
    "dev": "node --watch-path=src --watch --experimental-strip-types src/index.ts",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@haipham22/browser-ext-agent-shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "playwright-core": "^1.65.1",
    "ws": "^8.18.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.21.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}